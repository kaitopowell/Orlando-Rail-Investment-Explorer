{
  "name": "sol-r",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke.mjs",
    "test:population": "node --experimental-strip-types scripts/test-population.mjs && node scripts/population-smoke.mjs",
    "test:transit": "node scripts/transit-smoke.mjs",
    "test:hexagons": "node scripts/hexagon-smoke.mjs",
    "test:employment": "node --experimental-strip-types scripts/test-employment-blocks.mjs && node scripts/employment-smoke.mjs",
    "test:equity": "node --experimental-strip-types scripts/test-equity.mjs && node scripts/equity-smoke.mjs",
    "test:lynx": "node --experimental-strip-types scripts/test-lynx.mjs && node scripts/lynx-smoke.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.2.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
