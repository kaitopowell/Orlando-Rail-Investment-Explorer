{
  "name": "sol-r",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke.mjs",
    "test:population": "node --experimental-strip-types scripts/test-population.mjs && node scripts/population-smoke.mjs",
    "test:transit": "node scripts/transit-smoke.mjs",
    "test:hexagons": "node scripts/hexagon-smoke.mjs",
    "test:employment": "node --experimental-strip-types scripts/test-employment-blocks.mjs && node scripts/employment-smoke.mjs",
    "test:equity": "node --experimental-strip-types scripts/test-equity.mjs && node scripts/equity-smoke.mjs",
    "test:lynx": "node --experimental-strip-types scripts/test-lynx.mjs && node scripts/lynx-smoke.mjs",
    "test:train-motion": "node --experimental-strip-types scripts/test-train-motion.mjs && node scripts/train-motion-smoke.mjs",
    "test:candidates": "node --experimental-strip-types scripts/test-candidates.mjs && node scripts/candidates-smoke.mjs",
    "test:flows": "node --experimental-strip-types scripts/test-flows.mjs && node scripts/flows-smoke.mjs",
    "test:rail-plan": "node --experimental-strip-types scripts/test-rail-plan.mjs && node scripts/rail-plan-smoke.mjs && node scripts/panels-smoke.mjs && node --experimental-strip-types scripts/usefulness-smoke.mjs",
    "test:sunshine": "node --experimental-strip-types scripts/test-sunshine.mjs && node scripts/sunshine-smoke.mjs",
    "lint": "eslint src",
    "test:usefulness": "vitest run src/data/railUsefulness.test.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.2.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.14.0",
    "playwright": "^1.64.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
